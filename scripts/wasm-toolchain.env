# Pinned toolchain for compiling WebLLM model_lib (.wasm) artifacts.
# Sourced by scripts/build-vicuna-wasm.sh and .github/workflows/build-vicuna-wasm.yml;
# mirrored in public/Jokesters_WebLLM_Compile.ipynb (tests/unit/wasmToolchain.test.ts checks they agree).
#
# Target runtime
#   web-llm 0.2.84 -> model_lib ABI folder v0_2_84 (binary-mlc-llm-libs), tvmjs @mlc-ai/web-runtime ^0.25.0-dev0
WEB_LLM_VERSION=0.2.84
MLC_LIB_ABI=v0_2_84

# Emscripten: upstream web-llm documents 3.1.56 as the known-good version for its tvmjs runtime
# ("latest" fails at load with: wasi_snapshot_preview1 proc_exit import is not callable).
EMSDK_VERSION=3.1.56

# mlc-llm source (+ its 3rdparty/tvm submodule) used to build the wasm runtime. This is the exact
# commit the pinned wheels below were built from (wheel mlc-llm-nightly 0.26.dev6 = v0.26.dev0 + 6 commits).
MLC_LLM_COMMIT=9fa644f54b04983adea4d0168f49fc6af4a893ba

# Python wheels from https://mlc.ai/wheels (compile driver + TVM).
MLC_AI_NIGHTLY_VERSION=0.26.dev246
MLC_LLM_NIGHTLY_VERSION=0.26.dev6
MLC_WHEEL_FLAVOR=cu128

# KNOWN GAP: the v0_2_84 libs upstream were built on TVM 0.25.x (May 2026). mlc.ai/wheels only serves the
# latest nightly, so the 0.25 wheels can no longer be installed; the pair above is the oldest reproducible
# one, built from a single consistent mlc-llm/TVM snapshot, but TVM 0.26 > the 0.25 runtime in web-llm 0.2.84.
# Verify a produced .wasm loads in a browser with web-llm 0.2.84 before uploading it.
