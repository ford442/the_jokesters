+import type { LogitProcessor } from "../types";
+
+export interface ComedyLogitProcessorOptions {
+  /** Penalize logits for tokens that would repeat recent n-grams. */
+  ngramSize?: number;
+  /** Strength of the anti-duplicate penalty (higher = stronger). */
+  ngramPenalty?: number;
+  /** Token ids to down-weight (e.g. cliché openers). */
+  clichéTokenIds?: number[];
+  /** Logit penalty applied to cliché tokens. */
+  clichéPenalty?: number;
+}
+
+/**
+ * Optional comedy-oriented logit processor: reduces near-duplicate n-grams and
+ * down-weights configured cliché token ids between decode steps.
+ */
+export class ComedyLogitProcessor implements LogitProcessor {
+  private readonly ngramSize: number;
+  private readonly ngramPenalty: number;
+  private readonly clichéTokenIds: Set<number>;
+  private readonly clichéPenalty: number;
+  private recentTokens: number[] = [];
+
+  constructor(options: ComedyLogitProcessorOptions = {}) {
+    this.ngramSize = Math.max(2, options.ngramSize ?? 4);
+    this.ngramPenalty = options.ngramPenalty ?? 2.5;
+    this.clichéTokenIds = new Set(options.clichéTokenIds ?? []);
+    this.clichéPenalty = options.clichéPenalty ?? 1.5;
+  }
+
+  processLogits(logits: Float32Array): Float32Array {
+    const out = new Float32Array(logits);
+
+    for (const tokenId of this.clichéTokenIds) {
+      if (tokenId >= 0 && tokenId < out.length) {
+        out[tokenId] -= this.clichéPenalty;
+      }
+    }
+
+    if (this.recentTokens.length >= this.ngramSize - 1) {
+      const prefix = this.recentTokens.slice(-(this.ngramSize - 1));
+      const seen = new Set<string>();
+      for (let i = 0; i <= this.recentTokens.length - this.ngramSize; i++) {
+        seen.add(this.recentTokens.slice(i, i + this.ngramSize).join(","));
+      }
+      const prefixKey = prefix.join(",");
+      for (let token = 0; token < out.length; token++) {
+        const candidate = prefixKey.length > 0 ? `${prefixKey},${token}` : String(token);
+        if (seen.has(candidate)) {
+          out[token] -= this.ngramPenalty;
+        }
+      }
+    }
+
+    return out;
+  }
+
+  processSampledToken(token: number): void {
+    this.recentTokens.push(token);
+    const maxHistory = this.ngramSize * 8;
+    if (this.recentTokens.length > maxHistory) {
+      this.recentTokens = this.recentTokens.slice(-maxHistory);
+    }
+  }
+
+  resetState(): void {
+    this.recentTokens = [];
+  }
+}
