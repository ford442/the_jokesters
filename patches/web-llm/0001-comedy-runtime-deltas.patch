+import {
+  DeviceLostError,
+  ShaderF16SupportError,
+  WebGPUNotAvailableError,
+  WebGPUNotFoundError,
+} from "../error";
+
+export type InitErrorCategory = "webgpu" | "oom" | "network" | "unknown";
+
+export class WebLLMInitError extends Error {
+  readonly category: InitErrorCategory;
+
+  constructor(category: InitErrorCategory, message: string, options?: { cause?: unknown }) {
+    super(message, options);
+    this.name = "WebLLMInitError";
+    this.category = category;
+  }
+}
+
+/**
+ * Classify initialization failures for user-facing error UI.
+ */
+export function classifyInitError(error: unknown): InitErrorCategory {
+  if (error instanceof WebLLMInitError) return error.category;
+  if (
+    error instanceof WebGPUNotAvailableError ||
+    error instanceof WebGPUNotFoundError ||
+    error instanceof ShaderF16SupportError
+  ) {
+    return "webgpu";
+  }
+  if (error instanceof DeviceLostError) return "oom";
+
+  const msg = (error instanceof Error ? error.message : String(error)).toLowerCase();
+
+  if (
+    msg.includes("webgpu") ||
+    (msg.includes("gpu") && msg.includes("not supported")) ||
+    msg.includes("shader-f16")
+  ) {
+    return "webgpu";
+  }
+
+  if (
+    msg.includes("oom") ||
+    msg.includes("out of memory") ||
+    msg.includes("createbuffer") ||
+    msg.includes("allocation") ||
+    msg.includes("mapasync") ||
+    msg.includes("device is lost") ||
+    msg.includes("device lost")
+  ) {
+    return "oom";
+  }
+
+  if (
+    msg.includes("fetch") ||
+    msg.includes("network") ||
+    msg.includes("failed to load") ||
+    msg.includes("err_") ||
+    msg.includes("cache.add") ||
+    msg.includes("cdn") ||
+    msg.includes("timeout") ||
+    msg.includes("aborterror")
+  ) {
+    return "network";
+  }
+
+  return "unknown";
+}
+
+const INIT_ERROR_HINTS: Record<InitErrorCategory, string> = {
+  webgpu:
+    "Use Chrome 113+ or Edge 113+ with hardware acceleration enabled.",
+  oom: "Close other GPU-heavy tabs and reload, or try a lower-VRAM model.",
+  network: "Check your connection and reload. Model weights download from the configured CDN.",
+  unknown: "Reload the page and try again. Copy the error details if the problem persists.",
+};
+
+export function getInitErrorHint(category: InitErrorCategory): string {
+  return INIT_ERROR_HINTS[category];
+}
+
+/**
+ * Wrap low-level init errors with a stable category + hint for callers.
+ */
+export function toInitError(error: unknown): WebLLMInitError {
+  if (error instanceof WebLLMInitError) return error;
+  const category = classifyInitError(error);
+  const raw = error instanceof Error ? error.message : String(error);
+  const hint = getInitErrorHint(category);
+  return new WebLLMInitError(category, `${raw}\n\n${hint}`, { cause: error });
+}
