+/**
+ * Streaming helpers for sentence-level TTS handoff in real-time comedy apps.
+ */
+
+const SENTENCE_END_RE = /[.!?…]["')\]]*\s*$/;
+const SENTENCE_END_WITH_NEWLINE_RE = /\n\s*$/;
+
+/**
+ * Returns true when `delta` ends on a sentence boundary suitable for TTS handoff.
+ */
+export function isSentenceBoundaryDelta(delta: string): boolean {
+  if (!delta) return false;
+  return SENTENCE_END_RE.test(delta) || SENTENCE_END_WITH_NEWLINE_RE.test(delta);
+}
+
+/**
+ * Scan cumulative assistant text and return newly completed sentences since `prevLength`.
+ */
+export function extractNewSentences(
+  fullText: string,
+  prevLength: number,
+): { sentences: string[]; newLength: number } {
+  const slice = fullText.slice(prevLength);
+  if (!slice.trim()) {
+    return { sentences: [], newLength: prevLength };
+  }
+
+  const sentences: string[] = [];
+  let cursor = 0;
+  const boundary = /[.!?…]["')\]]*(\s+|\n+)/g;
+  let match: RegExpExecArray | null;
+  while ((match = boundary.exec(slice)) !== null) {
+    const end = match.index + match[0].length;
+    const sentence = slice.slice(cursor, end).trim();
+    if (sentence) sentences.push(sentence);
+    cursor = end;
+  }
+
+  return { sentences, newLength: prevLength + cursor };
+}
