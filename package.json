{
  "name": "the_jokesters",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:webllm": "bash scripts/build-webllm.sh",
    "verify:webllm": "bash scripts/verify-webllm-dist.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:webllm": "npm run build:webllm && tsc --noEmit -p tsconfig.webllm.json",
    "build:custom-webllm": "npm run build:webllm && USE_CUSTOM_WEBLLM=1 npm run build",
    "preview": "vite preview",
    "perf": "tsx tests/perf/ci-runner.ts",
    "perf:quick": "tsx tests/perf/ci-runner.ts --duration=quick",
    "perf:full": "tsx tests/perf/ci-runner.ts --duration=full",
    "perf:ci": "tsx tests/perf/ci-runner.ts --duration=ci --format=json",
    "perf:browser": "vite tests/perf/browser-runner.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:chaos": "node src/test/chaosTestRunner.cjs",
    "verify:wllama": "bash scripts/verify_wllama_wasm.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "0.170.0",
    "@vitest/coverage-v8": "^4.1.10",
    "puppeteer": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@mlc-ai/web-llm": "^0.2.8",
    "@wllama/wllama": "2.4.0",
    "onnxruntime-web": "^1.17.0",
    "three": "0.170.0",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
