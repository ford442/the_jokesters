{
  "name": "the_jokesters",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "perf": "tsx tests/perf/ci-runner.ts",
    "perf:quick": "tsx tests/perf/ci-runner.ts --duration=quick",
    "perf:full": "tsx tests/perf/ci-runner.ts --duration=full",
    "perf:ci": "tsx tests/perf/ci-runner.ts --duration=ci --format=json",
    "perf:browser": "vite tests/perf/browser-runner.html",
    "test:unit": "tsx tests/unit/tokenBudget.test.ts && tsx tests/unit/contextDepth.test.ts && tsx tests/unit/modeRegistry.test.ts",
    "verify:wllama": "bash scripts/verify_wllama_wasm.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "0.170.0",
    "puppeteer": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@mlc-ai/web-llm": "^0.2.8",
    "@wllama/wllama": "2.4.0",
    "onnxruntime-web": "^1.17.0",
    "three": "0.170.0",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
