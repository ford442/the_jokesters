{
  "name": "the_jokesters",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "build:webllm": "bash scripts/build-webllm.sh",
    "verify:webllm": "bash scripts/verify-webllm-dist.sh",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:ci": "node scripts/check-any-ratchet.mjs",
    "lint:any:update": "node scripts/check-any-ratchet.mjs --update",
    "registry:check": "node scripts/generate-mode-registry.mjs --check",
    "typecheck:webllm": "npm run build:webllm && tsc --noEmit -p tsconfig.webllm.json",
    "build:custom-webllm": "npm run build:webllm && USE_CUSTOM_WEBLLM=1 npm run build",
    "preview": "vite preview",
    "perf": "tsx tests/perf/ci-runner.ts",
    "perf:quick": "tsx tests/perf/ci-runner.ts --duration=quick",
    "perf:full": "tsx tests/perf/ci-runner.ts --duration=full",
    "perf:ci": "tsx tests/perf/ci-runner.ts --duration=ci --format=json",
    "perf:browser": "vite tests/perf/browser-runner.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "verify:wllama": "bash scripts/verify_wllama_wasm.sh",
    "deploy": "npm run build && python3 scripts/deploy_dist.py",
    "deploy:dry": "npm run build && python3 scripts/deploy_dist.py --dry-run",
    "deploy:verify": "npm run build && python3 scripts/deploy_dist.py --verify"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "0.170.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "puppeteer": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.2.4",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "0.2.84",
    "@pixiv/three-vrm": "^3.5.5",
    "@wllama/wllama": "2.4.0",
    "mp4-muxer": "^5.2.2",
    "onnxruntime-web": "~1.26.0",
    "three": "0.170.0",
    "yjs": "^13.6.31",
    "zod": "^4.6.7"
  },
  "overrides": {
    "onnxruntime-web": "$onnxruntime-web"
  }
}
