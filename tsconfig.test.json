{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "src/vite-env.d.ts",
    "src/types/**/*.d.ts",
    // Imports src/ (DOM types), so it is checked here rather than in tsconfig.node.json.
    "scripts/export-comedy-prompts.ts"
  ]
}
