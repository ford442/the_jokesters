# Copy to .env.local (gitignored via *.local) and adjust.
# Never put real SFTP passwords or private keys in files that might be committed.

# Primary model/TTS CDN (no trailing slash). Used at build time by Vite.
VITE_VPS_STORAGE_ORIGIN=https://storage.1ink.us

# Optional mirror (ops / documentation; SW still hard-lists both hosts).
VITE_VPS_STORAGE_MIRROR_ORIGIN=https://storage.noahcohn.com

# --- Deploy (shell env for scripts/deploy_dist.py; not read by Vite) ---
# DEPLOY_HOST=1ink.us
# DEPLOY_USER=
# DEPLOY_KEY=~/.ssh/id_ed25519
# DEPLOY_PASS=
# DEPLOY_REMOTE_DIR=/var/www/the-jokesters
# DEPLOY_CLEAN=0
